#!/bin/sh
# FDTP's ./configure (for those who build it from the source). Not autoconf.
#
#   ./configure [--yes] [--lang=ja|en|auto] [--prefix=DIR] [--no-pomera]
#   make
#   sudo make install       (sudo make uninstall to remove it)
#
# 1. Checks what the build needs (pkg-config and the compiler) and stops
#    with the Debian packages to install when something is missing. The
#    list follows Makefile, mk/*.mk and the platform layer's sources.mk
#    (port/app/platform here, lib/rmp-platform in the public copy)
#    (tests/check_configure.py checks that it does).
# 2. Asks, each question after what it does and how to undo it: the
#    language of the screens; on Linux, installing libheif for HEIC photos
#    when it is missing (root only; others are told the apt line); on a
#    Pomera DM250 only, the Wi-Fi stability settings and the read-only mount
#    of the internal memory, PD hub charging and the CVE-2026-98432 mitigation.
#    Enter takes the default; --yes, or no terminal, takes every default.
#    Own kernels skip the three workarounds; ask about Wi-Fi power saving
#    and removing old workarounds instead. LOCAL RTC is offered UTC on any DM250.
# 3. Writes the answers to config.mk, which mk/install.mk reads.
# Messages are in Japanese when LC_ALL, LC_MESSAGES or LANG (the first one
# set) is ja* (not on the Linux console, which cannot show Japanese).
#
# For the tests (tests/check_configure.py) these replace the machine:
#   FDTP_CONFIG_MK          the file written (default config.mk here)
#   FDTP_CONFIGURE_UNAME    uname -s
#   FDTP_CONFIGURE_DT       /proc/device-tree (its compatible and model)
#   FDTP_CONFIGURE_OWNKERNEL yes|no: own-kernel directory detection
#   FDTP_CONFIGURE_ADJTIME  /etc/adjtime (third line LOCAL asks about UTC)
#   FDTP_CONFIGURE_UID      id -u
#   FDTP_CONFIGURE_PROBE    the internal memory probe (a command printing
#                           vfat or exfat when found)
#   FDTP_CONFIGURE_PDCHARGE_PROBE  read-only PD charger probe (test command)
#   FDTP_CONFIGURE_CVE_PROBE  read-only CVE kernel probe (test command)
#   FDTP_CVE_UNAME_R        uname -r for the CVE kernel probe
#   FDTP_CONFIGURE_TTY      yes|no: whether to ask (default: stdin is a terminal)
#   FDTP_CONFIGURE_HEIF     yes|no: whether libheif is installed
#   FDTP_CONFIGURE_APT      the apt-get command (installing libheif)
#   FDTP_CONFIGURE_BREW     the Homebrew prefix (default /opt/homebrew)
#   PKG_CONFIG, CC          as usual
# This file is part of FDTP (File & Directory Tool for Pomera).
# SPDX-FileCopyrightText: 2026 yasoteien
# SPDX-License-Identifier: AGPL-3.0-or-later
set -u
LC_COLLATE=C; export LC_COLLATE

SELF=$(cd "$(dirname "$0")" && pwd)
if [ -f "$SELF/mk/install.mk" ]; then SRC=$SELF
elif [ -f "$SELF/fdtp/mk/install.mk" ]; then SRC=$SELF/fdtp
else echo "configure: mk/install.mk not found next to $0" >&2; exit 1
fi
# The Pomera scripts: pomera/ here, scripts/pomera/ in the public copy.
if [ -d "$SRC/scripts/pomera" ]; then PDIR=$SRC/scripts/pomera; else PDIR=$SRC/pomera; fi
OUT=${FDTP_CONFIG_MK:-$SRC/config.mk}
UNAME=${FDTP_CONFIGURE_UNAME:-$(uname -s)}
DT=${FDTP_CONFIGURE_DT:-/proc/device-tree}
UID_NOW=${FDTP_CONFIGURE_UID:-$(id -u)}
PKG_CONFIG=${PKG_CONFIG:-pkg-config}
CC=${CC:-cc}

# ---- the libraries (kind name Debian package need/opt feature) -------------
# pc: a pkg-config module. lib: -lNAME with the header after the colon.
DEPS='pc libdrm libdrm-dev need screen
pc gbm libgbm-dev need screen
pc egl libegl-dev need screen
pc glesv2 libgles-dev need screen
pc xcb libxcb1-dev opt x11
pc libjpeg libjpeg-dev need images
pc libpng libpng-dev need images
pc libwebp libwebp-dev need images
lib gif:gif_lib.h libgif-dev need images
pc zlib zlib1g-dev need office
pc expat libexpat1-dev need office
lib mupdf:mupdf/fitz.h libmupdf-dev need pdf
lib uim:uim/uim.h libuim-dev opt ime
lib uim-scm:uim/uim.h libuim-dev opt ime
pc openssl libssl-dev opt localsend'
# Commands FDTP runs (archives): missing ones only warn.
RUNTIME='zip zip
unzip unzip
lhasa lhasa
tar tar'

# ---- options ------------------------------------------------------------------
YES=0 NOPOMERA=0 LANG_ANSWER= PREFIX=/usr/local
usage() { sed -n '2,6p' "$0"; }
while [ $# -gt 0 ]; do
	case $1 in
	-y|--yes) YES=1 ;;
	--no-pomera) NOPOMERA=1 ;;
	--lang=*) LANG_ANSWER=${1#*=} ;;
	--lang) [ $# -gt 1 ] || { usage >&2; exit 2; }; LANG_ANSWER=$2; shift ;;
	--prefix=*) PREFIX=${1#*=} ;;
	--prefix) [ $# -gt 1 ] || { usage >&2; exit 2; }; PREFIX=$2; shift ;;
	--list-deps) printf '%s\n' "$DEPS"; exit 0 ;;
	-h|--help) usage; exit 0 ;;
	*) echo "configure: unknown option $1" >&2; usage >&2; exit 2 ;;
	esac
	shift
done
case $LANG_ANSWER in ''|ja|en|auto) ;; *) echo "configure: --lang is ja, en or auto" >&2; exit 2 ;; esac
case $PREFIX in /*) ;; *) echo "configure: --prefix must be an absolute path" >&2; exit 2 ;; esac
case $PREFIX in *[!A-Za-z0-9/._+-]*) echo "configure: --prefix may only have letters, digits and / . _ + -" >&2; exit 2 ;; esac
while :; do case $PREFIX in /?*/) PREFIX=${PREFIX%/} ;; *) break ;; esac; done

# ---- messages ----------------------------------------------------------------
# msg_init, pick, say, warn, tty_init, ask_yn and the Pomera questions are
# shared with pomera_setup.sh (fdtp-pomera-setup of the .deb).
PQ_AGAIN=make-install
. "$PDIR/pomera_questions.sh"
msg_init
tty_init "$YES"

if [ -n "$CONSOLE_NOTE" ]; then
	echo "(LANG is ja*, but the Linux console cannot show Japanese: the messages are in English.)"
fi
say "FDTP の ./configure（${SRC}）" "FDTP's ./configure ($SRC)"

# ---- 1. what the build needs ------------------------------------------------------
TMPD=$(mktemp -d "${TMPDIR:-/tmp}/fdtp-configure.XXXXXX") || exit 1
trap 'rm -rf "$TMPD"' EXIT INT TERM
MISSING= HAVE_XCB=no HAVE_UIM=no HAVE_SSL=no
add_missing() { case " $MISSING " in *" $1 "*) ;; *) MISSING="$MISSING $1" ;; esac; }
found() { printf '  %-28s %s\n' "$1" "$(pick "あり" "found")"; }
lacking() { printf '  %-28s %s\n' "$1" "$(pick "無し（$2）" "missing ($2)")"; }
have_cmd() { command -v "$1" >/dev/null 2>&1; }

say "== 作るのに要る物 ==" "== What the build needs =="
if [ "$UNAME" = Darwin ]; then
	# The Mac builds fdtp-preview only (screen checks and tests); Makefile
	# takes the image libraries from Homebrew and the rest from the SDK.
	for t in "$CC" make python3; do
		if have_cmd "$t"; then found "$t"; else lacking "$t" "xcode-select --install / python3"; add_missing "$t"; fi
	done
	for p in jpeg-turbo libpng giflib webp; do
		if [ -d "/opt/homebrew/opt/$p" ]; then found "$p (Homebrew)"
		else lacking "$p (Homebrew)" "brew install $p"; warn "Homebrew の $p がありません: brew install jpeg-turbo libpng giflib webp" \
			"Homebrew's $p is missing: brew install jpeg-turbo libpng giflib webp"; fi
	done
	if [ -n "$MISSING" ]; then
		say "足りない物があります:$MISSING" "Missing:$MISSING"
		exit 1
	fi
else
	for t in "$CC:build-essential" make:build-essential python3:python3 "$PKG_CONFIG:pkg-config"; do
		cmd=${t%:*} pkg=${t##*:}
		set -- $cmd
		if have_cmd "$1"; then found "$cmd"; else lacking "$cmd" "apt: $pkg"; add_missing "$pkg"; fi
	done
	if [ -z "$MISSING" ]; then
		printf 'int main(void) { return 0; }\n' > "$TMPD/t.c"
		printf '%s\n' "$DEPS" | while read -r kind name pkg need feature; do
			case $kind in
			pc) $PKG_CONFIG --exists "$name" 2>/dev/null && echo "ok $kind $name $pkg $need $feature" || echo "no $kind $name $pkg $need $feature" ;;
			lib)
				lib=${name%%:*} header=${name#*:}
				printf '#include <%s>\nint main(void) { return 0; }\n' "$header" > "$TMPD/t.c"
				if $CC ${CPPFLAGS:-} ${CFLAGS:-} -o "$TMPD/t" "$TMPD/t.c" ${LDFLAGS:-} "-l$lib" >/dev/null 2>&1; then echo "ok $kind $lib $pkg $need $feature"
				else echo "no $kind $lib $pkg $need $feature"; fi ;;
			esac
		done > "$TMPD/deps"
		while read -r ok kind name pkg need feature; do
			label="$name ($pkg)"
			if [ "$ok" = ok ]; then
				found "$label"
				case $feature in x11) HAVE_XCB=yes ;; ime) [ "$name" = uim ] && HAVE_UIM=yes ;; localsend) HAVE_SSL=yes ;; esac
			elif [ "$need" = need ]; then lacking "$label" "apt: $pkg"; add_missing "$pkg"
			else lacking "$label" "$(pick "任意" "optional")"
			fi
		done < "$TMPD/deps"
		# Both halves of libuim must be there.
		grep -q '^no lib uim-scm ' "$TMPD/deps" && HAVE_UIM=no
	fi
	if [ -n "$MISSING" ]; then
		say "足りない物があります。次で入れてから、もう一度 ./configure を流してください:" \
			"Some packages are missing. Install them, then run ./configure again:"
		echo "  sudo apt install$MISSING"
		exit 1
	fi
	[ "$HAVE_XCB" = yes ] || warn "libxcb1-dev が無いので、X のウィンドウ無し（DRM/KMS だけ）で作ります。" \
		"no libxcb1-dev: FDTP is built without the X window (DRM/KMS only)."
	[ "$HAVE_UIM" = yes ] || warn "libuim-dev が無いので、日本語入力無し（NOVEL_IME=ime_none）で作ります。" \
		"no libuim-dev: FDTP is built without Japanese input (NOVEL_IME=ime_none)."
	[ "$HAVE_SSL" = yes ] || warn "libssl-dev が無いので、LocalSend の送受信（fdtp-localsend）無しで作ります。" \
		"no libssl-dev: FDTP is built without LocalSend (fdtp-localsend)."
	runtime_missing=
	while read -r cmd pkg; do have_cmd "$cmd" || runtime_missing="$runtime_missing $pkg"; done <<EOF
$RUNTIME
EOF
	[ -z "$runtime_missing" ] || warn "書庫に使うコマンドがありません。使うなら: sudo apt install$runtime_missing" \
		"commands for archives are missing; to use them: sudo apt install$runtime_missing"
fi

# ---- 2. questions -----------------------------------------------------------------
question_hint
case $locale_now in ja*) lang_auto=$(pick "日本語" "Japanese") ;; *) lang_auto=English ;; esac
echo
if [ -n "$LANG_ANSWER" ]; then
	say "== 画面の言語: ${LANG_ANSWER}（--lang） ==" "== Language: $LANG_ANSWER (--lang) =="
else
	say "== 画面の言語 ==" "== Language =="
	say "FDTP の画面の言語です。あとで設定（z）でも変えられます。" \
		"The language of FDTP's screens. It can be changed later in the settings (z)."
	say "  1) 日本語" "  1) 日本語 (Japanese)"
	echo "  2) English"
	say "  3) auto（LANG に従う。今は ${lang_auto}）" "  3) auto (follows LANG; now $lang_auto)"
	if [ "$TTY" != yes ]; then
		LANG_ANSWER=auto
		say "番号を選んでください [3] → 3（既定の答え、${why}）" "Choose a number [3] -> 3 (the default, $why)"
	else
		while [ -z "$LANG_ANSWER" ]; do
			printf '%s ' "$(pick "番号を選んでください [3]" "Choose a number [3]")"
			if ! read -r a; then a=; echo; fi
			case $a in
			1|ja) LANG_ANSWER=ja ;; 2|en) LANG_ANSWER=en ;; ''|3|auto) LANG_ANSWER=auto ;;
			*) say "1・2・3 のどれかで答えてください。" "Please answer 1, 2 or 3." ;;
			esac
		done
	fi
fi

# HEIC: libheif is read with dlopen (src/img_modern.c), not needed to build.
HEIF=no
echo
if [ "$UNAME" = Darwin ]; then
	say "== HEIC（iPhone の写真） ==" "== HEIC (iPhone photos) =="
	if [ -d "${FDTP_CONFIGURE_BREW:-/opt/homebrew}/opt/libheif" ]; then
		HEIF=yes
		say "Homebrew の libheif があるので、HEIC を開けます。" "Homebrew's libheif is there: HEIC opens."
	else
		say "HEIC を開くには libheif が要ります。入れるには: brew install libheif" \
			"Opening HEIC needs libheif. To install it: brew install libheif"
	fi
else
	ask_heif
fi

STABILITY=no INTERNAL=keep PDCHARGE=keep CVE=keep WIFI_PS=keep CLEAN_OLD=keep RTC=keep KERNEL_APT=keep POMERA=no
if [ "$UNAME" = Linux ] && [ "$NOPOMERA" = 0 ] && is_dm250 "$DT"; then POMERA=yes; fi
if [ "$POMERA" = yes ]; then
	echo
	ask_pomera
fi

# ---- 3. config.mk -------------------------------------------------------------------
tmp=$OUT.tmp.$$
{
	echo "# Made by ./configure on $(date '+%Y-%m-%d %H:%M'). Run ./configure again to change it."
	echo "# mk/install.mk reads it (not in cross builds)."
	echo "FDTP_CONFIGURED = yes"
	echo "PREFIX = $PREFIX"
	echo "FDTP_LANGUAGE = $LANG_ANSWER"
	echo "POMERA_STABILITY = $STABILITY"
	echo "POMERA_INTERNAL = $INTERNAL"
	echo "POMERA_PDCHARGE = $PDCHARGE"
	echo "POMERA_CVE = $CVE"
	echo "POMERA_WIFI_PS = $WIFI_PS"
	echo "POMERA_CLEAN_OLD = $CLEAN_OLD"
	echo "POMERA_RTC = $RTC"
	echo "POMERA_KERNEL_APT = $KERNEL_APT"
	echo "HAVE_XCB = $HAVE_XCB"
	echo "HAVE_UIM = $HAVE_UIM"
	if [ "$UNAME" != Darwin ] && [ "$HAVE_UIM" = no ]; then echo "NOVEL_IME = ime_none"; fi
} > "$tmp" && mv -f "$tmp" "$OUT" || { rm -f "$tmp"; echo "configure: cannot write $OUT" >&2; exit 1; }

echo
say "== 設定（$OUT に書きました） ==" "== Settings (written to $OUT) =="
printf '  %s: %s\n' "PREFIX" "$PREFIX"
printf '  %s: %s\n' "$(pick "言語" "language")" "$LANG_ANSWER"
printf '  %s: %s\n' "$(pick "HEIC（libheif）" "HEIC (libheif)")" "$HEIF"
if [ "$POMERA" = yes ]; then
	case $STABILITY in
	 yes) printf '  %s: %s\n' "$(pick "Wi-Fi の安定化" "Wi-Fi stability")" "$(pick "省電力オフ・停止時の自動再起動を設定（SD の書き換えは別途確認）" "disable power saving and enable automatic restart on a freeze (SD rewriting confirmed separately)")" ;;
	 no) printf '  %s: %s\n' "$(pick "Wi-Fi の安定化" "Wi-Fi stability")" "$(pick "既存設定を変更しない" "keep existing settings")" ;;
	esac
	case $INTERNAL in
	 ro) printf '  %s: %s\n' "$(pick "内蔵文書の利用設定" "internal document access")" "$(pick "起動時に読み取り専用で自動利用" "automatic read-only access at boot")" ;;
	 rw) printf '  %s: %s\n' "$(pick "内蔵文書の利用設定" "internal document access")" "$(pick "起動時に点検して読み書きで自動利用" "check and allow automatic read-write access at boot")" ;;
	 no) printf '  %s: %s\n' "$(pick "内蔵文書の利用設定" "internal document access")" "$(pick "起動時の自動利用を解除" "remove automatic access at boot")" ;;
	 keep) printf '  %s: %s\n' "$(pick "内蔵文書の利用設定" "internal document access")" "$(pick "既存設定を変更しない" "keep existing settings")" ;;
	esac
	case $PDCHARGE in
	 yes) printf '  %s: %s\n' "$(pick "PD ハブ充電・充電 LED" "PD hub charging / charge LEDs")" "$(pick "追加の充電制御を有効にする（充電 LED は部品がある場合のみ）" "enable additional charging control (charge LEDs only if the component is available)")" ;;
	 no) printf '  %s: %s\n' "$(pick "PD ハブ充電・充電 LED" "PD hub charging / charge LEDs")" "$(pick "以前の充電・充電 LED 設定を解除" "remove earlier charging and charge LED settings")" ;;
	 keep) printf '  %s: %s\n' "$(pick "PD ハブ充電・充電 LED" "PD hub charging / charge LEDs")" "$(pick "既存設定を変更しない" "keep existing settings")" ;;
	esac
	case $CVE in
	 yes) printf '  %s: %s\n' "CVE-2026-98432" "$(pick "対象の通信データを遮断する対策を有効にする" "enable mitigation to block affected network data")" ;;
	 no) printf '  %s: %s\n' "CVE-2026-98432" "$(pick "以前の対策を解除" "remove earlier mitigation")" ;;
	 keep) printf '  %s: %s\n' "CVE-2026-98432" "$(pick "既存設定を変更しない" "keep existing settings")" ;;
	esac
	if own_kernel; then
		case $WIFI_PS in
		 on) printf '  %s: %s\n' "$(pick "Wi-Fi の省電力" "Wi-Fi power saving")" "$(pick "オン（以前の省電力オフ設定を解除）" "on (remove earlier power-saving-off settings)")" ;;
		 off) printf '  %s: %s\n' "$(pick "Wi-Fi の省電力" "Wi-Fi power saving")" "$(pick "オフにする" "turn off")" ;;
		 keep) printf '  %s: %s\n' "$(pick "Wi-Fi の省電力" "Wi-Fi power saving")" "$(pick "既存設定を変更しない" "keep existing settings")" ;;
		esac
		case $CLEAN_OLD in
		 yes) printf '  %s: %s\n' "$(pick "古い回避策の削除" "remove old workarounds")" "$(pick "一覧の旧対策を解除（Wi-Fi の省電力設定は残す）" "remove listed old workarounds (keep Wi-Fi power-saving setting)")" ;;
		 no|keep) printf '  %s: %s\n' "$(pick "古い回避策の削除" "remove old workarounds")" "$(pick "既存設定を変更しない" "keep existing settings")" ;;
		esac
	fi
	case $KERNEL_APT in
	 yes) printf '  %s: %s\n' "$(pick "pomera-kernel（試験版）の apt 配布元" "apt distribution source for pomera-kernel (test release)")" "$(pick "pomera-kernel（試験版、カーネルと U-Boot の組）を導入して次回起動で試す" "install pomera-kernel (test release, the kernel and U-Boot as a set) and try it on next boot")" ;;
	 source) printf '  %s: %s\n' "$(pick "pomera-kernel（試験版）の apt 配布元" "apt distribution source for pomera-kernel (test release)")" "$(pick "配布元の登録のみ（署名確認用の鍵も登録）" "register distribution source only (including signature verification key)")" ;;
	 no|keep) printf '  %s: %s\n' "$(pick "pomera-kernel（試験版）の apt 配布元" "apt distribution source for pomera-kernel (test release)")" "$(pick "既存設定を変更しない" "keep existing settings")" ;;
	esac
	if [ "$RTC" = yes ]; then printf '  RTC (UTC): %s\n' "$RTC"; fi
fi
say "次に:" "Next:"
if [ "$UNAME" = Darwin ]; then
	say "  make        （macOS では画面の確認用の fdtp-preview だけができます。make install は Linux 用です）" \
		"  make        (on macOS only fdtp-preview, for checking the screens, is built; make install is for Linux)"
else
	echo "  make -j4"
	echo "  sudo make install"
fi
